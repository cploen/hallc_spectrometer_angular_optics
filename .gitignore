# Campaign and generated workflow outputs
HMS_*/
SHMS_*/
demo/
archive/

# Python cache
__pycache__/
*.py[cod]

# Development backups
*.bak*
*.before_*
*.retired

# Generated ROOT and analysis outputs
*.root
*.pdf
*.png
*.jpg
*.jpeg
*_C.d
*_C_ACLiC_dict_rdict.pcm

# Logs and temporary files
*.log
*.tmp
*.swp
*~

# OS files
.DS_Store

# Checked-in preliminary 6.667 GeV conditioning bundle.  Keep the rest of the
# campaign workspace ignored while exposing this self-contained analysis set.
!HMS_6p667GeV/
HMS_6p667GeV/*
!HMS_6p667GeV/08_preliminary_conditioning/
!HMS_6p667GeV/08_preliminary_conditioning/**

# Reproducible presentation QA files and transient PowerPoint metadata are not
# analysis data and should not be committed.
HMS_6p667GeV/08_preliminary_conditioning/deck_build/
HMS_6p667GeV/08_preliminary_conditioning/*.inspect.ndjson
HMS_6p667GeV/08_preliminary_conditioning/~$*.pptx

# SHMS campaign: retain only reviewed input metadata and notes, never outputs.
!SHMS_8p5695GeV/
SHMS_8p5695GeV/*
!SHMS_8p5695GeV/README.md
!SHMS_8p5695GeV/config/
SHMS_8p5695GeV/config/*
!SHMS_8p5695GeV/config/rungroups_8p5695_inputs.tsv
!SHMS_8p5695GeV/config/ztar_runlist.txt

# Campaign core-selection override
!HMS_6p667GeV/config/
HMS_6p667GeV/config/*
!HMS_6p667GeV/config/core_sample.json

# TEMPORARY: expose core-sample campaign diagnostics to GitHub/Astra
!HMS_6p667GeV/05c_core_sample/
HMS_6p667GeV/05c_core_sample/*
!HMS_6p667GeV/05c_core_sample/core/
HMS_6p667GeV/05c_core_sample/core/*
!HMS_6p667GeV/05c_core_sample/core/plots/
!HMS_6p667GeV/05c_core_sample/core/plots/*.png

# TEMPORARY: additional core-sample diagnostics for GitHub/Astra
!HMS_6p667GeV/05c_core_sample/core/config.json
!HMS_6p667GeV/05c_core_sample/core/manifest.json
!HMS_6p667GeV/05c_core_sample/core/tsv/
