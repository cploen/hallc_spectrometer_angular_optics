# Startup macro. Run from the CMake build directory so preset macros are found.
# All layers share the same immutable scene. Default: geometry + short plane names.
/vis/open OGL 1200x850-0+0
/vis/viewer/set/autoRefresh false
/vis/scene/create HMS_sieve_coordinate_audit
/vis/scene/add/userAction all
/vis/sceneHandler/attach
/vis/viewer/set/background white
/vis/viewer/set/viewpointVector 1 1 1
/vis/viewer/set/upVector 0 1 0
/control/execute view_geometry.mac
/vis/viewer/flush
