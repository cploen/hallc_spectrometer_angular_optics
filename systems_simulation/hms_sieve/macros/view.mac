# Run from the CMake build directory, with the generated scene path passed to
# hms_geometry_viewer. OGL availability depends on the local Geant4 build.
# This scene contains coordinate primitives, not surveyed material volumes.
/vis/open OGL 1200x850-0+0
/vis/scene/create HMS_sieve_coordinate_audit
/vis/scene/add/userAction HMS_coordinate_scene
/vis/sceneHandler/attach
/vis/viewer/set/background white
/vis/viewer/set/viewpointVector 1 1 1
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/autoRefresh true
/vis/viewer/flush
